<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>xStocks Points Airdrop Calculator</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    body {
      background: #0a0a0a;
      color: #e5e5e5;
      min-height: 100vh;
      padding: 30px 20px;
      display: flex;
      justify-content: center;
      align-items: flex-start;
    }

    .container {
      max-width: 1100px;
      width: 100%;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }

    .logo-xstock {
      height: 42px;
      width: auto;
      object-fit: contain;
    }

    .logo-dc {
      height: 42px;
      width: 42px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #333;
      transition: opacity 0.2s;
    }

    .logo-dc:hover {
      opacity: 0.8;
    }

    h1 {
      text-align: center;
      font-size: 42px;
      font-weight: 800;
      margin-bottom: 12px;
      color: #fff;
      line-height: 1.15;
    }

    .register-boost {
      text-align: center;
      margin-bottom: 32px;
      font-size: 15px;
    }

    .register-boost a {
      color: #2dd4bf;
      text-decoration: none;
      font-weight: 600;
    }

    .register-boost a:hover {
      text-decoration: underline;
    }

    .main {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    @media (max-width: 800px) {
      .main {
        grid-template-columns: 1fr;
      }
      h1 {
        font-size: 32px;
      }
      .logo-xstock {
        height: 34px;
      }
      .logo-dc {
        height: 34px;
        width: 34px;
      }
    }

    .card {
      background: #141414;
      border: 1px solid #222;
      border-radius: 16px;
      padding: 28px;
    }

    label {
      display: block;
      font-size: 15px;
      font-weight: 600;
      color: #e5e5e5;
      margin-bottom: 10px;
    }

    .fixed-points {
      font-size: 26px;
      font-weight: 700;
      color: #2dd4bf;
      margin-bottom: 6px;
      letter-spacing: 0.3px;
    }

    .points-source {
      font-size: 12px;
      color: #666;
      margin-bottom: 28px;
    }

    input[type="text"] {
      width: 100%;
      background: #1a1a1a;
      border: 1px solid #333;
      border-radius: 10px;
      padding: 14px 16px;
      color: #fff;
      font-size: 16px;
      outline: none;
      transition: border 0.2s;
      margin-bottom: 28px;
    }

    input[type="text"]:focus {
      border-color: #2dd4bf;
    }

    .btn-group {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 28px;
    }

    .btn {
      background: #1f1f1f;
      border: 1px solid #333;
      color: #ccc;
      padding: 10px 16px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 500;
      transition: all 0.15s;
    }

    .btn:hover {
      background: #2a2a2a;
    }

    .btn.active {
      background: #2dd4bf;
      color: #000;
      border-color: #2dd4bf;
      font-weight: 600;
    }

    .main-result {
      background: #0f0f0f;
      border-radius: 16px;
      padding: 36px 20px;
      text-align: center;
      margin-bottom: 28px;
    }

    .main-result-label {
      font-size: 14px;
      color: #888;
      margin-bottom: 10px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .main-result-value {
      font-size: 52px;
      font-weight: 700;
      color: #2dd4bf;
      margin-bottom: 24px;
      letter-spacing: -0.5px;
    }

    .details {
      display: flex;
      justify-content: center;
      gap: 40px;
      flex-wrap: wrap;
      font-size: 14px;
      color: #aaa;
    }

    .detail-item {
      text-align: center;
    }

    .detail-label {
      font-size: 12px;
      color: #666;
      margin-bottom: 4px;
    }

    .detail-value {
      font-size: 16px;
      color: #fff;
      font-weight: 500;
    }

    .detail-value.highlight {
      color: #2dd4bf;
      font-weight: 600;
      font-size: 18px;
    }

    .scenarios {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .scenario {
      background: #1a1a1a;
      border-radius: 12px;
      padding: 14px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .scenario-name {
      font-weight: 600;
      color: #e5e5e5;
    }

    .scenario-info {
      font-size: 13px;
      color: #888;
      margin-top: 2px;
    }

    .scenario-value {
      font-weight: 600;
      color: #fff;
    }

    .formula {
      font-size: 13px;
      color: #888;
      margin-top: 8px;
      line-height: 1.6;
      background: #1a1a1a;
      padding: 16px;
      border-radius: 12px;
      text-align: center;
    }

    .formula a {
      color: #2dd4bf;
      text-decoration: none;
      font-weight: 600;
    }

    .formula a:hover {
      text-decoration: underline;
    }

    .farm-text {
      margin-top: 14px;
      font-size: 14px;
      color: #ccc;
      line-height: 1.5;
    }

    .footer {
      margin-top: 40px;
      text-align: center;
      font-size: 13px;
      color: #666;
      line-height: 1.7;
    }

    .footer a {
      color: #2dd4bf;
      text-decoration: none;
    }

    .footer a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="container">

    <div class="header">
      <img src="logo_xstock.png" alt="xStocks Logo" class="logo-xstock">
      <a href="https://x.com/DragonCrip" target="_blank" rel="noopener noreferrer">
        <img src="Logo_DC.jpg" alt="DragonCrip" class="logo-dc">
      </a>
    </div>

    <h1>xStocks Points<br>Airdrop Calculator</h1>
    
    <p class="register-boost">
      ⭐ <a href="https://defi.xstocks.fi/points?ref=DRAGON" target="_blank">Register for +20% xPoints boost</a>
    </p>

    <div class="main">
      <!-- LEFT -->
      <div class="card">
        <label>Total points distributed to date</label>
        <div class="fixed-points" id="totalPointsLabel">14,275,314,418</div>
        <div class="points-source">Data from xpoints.io · updates hourly</div>

        <label>Your points</label>
        <input type="text" id="yourPoints" placeholder="0" oninput="formatAndCalculate(this)">

        <label>Airdrop % of supply</label>
        <div class="btn-group" id="airdropGroup">
          <button class="btn" onclick="setAirdrop(5, this)">5%</button>
          <button class="btn active" onclick="setAirdrop(10, this)">10%</button>
          <button class="btn" onclick="setAirdrop(15, this)">15%</button>
          <button class="btn" onclick="setAirdrop(20, this)">20%</button>
          <button class="btn" onclick="setAirdrop(25, this)">25%</button>
        </div>

        <label>FDV (Fully Diluted Valuation)</label>
        <div class="btn-group" id="fdvGroup">
          <button class="btn" onclick="setFDV(50, this)">$50M</button>
          <button class="btn" onclick="setFDV(100, this)">$100M</button>
          <button class="btn active" onclick="setFDV(250, this)">$250M</button>
          <button class="btn" onclick="setFDV(500, this)">$500M</button>
          <button class="btn" onclick="setFDV(1000, this)">$1B</button>
        </div>

        <div class="formula">
          Point price = (FDV × Airdrop %) ÷ Total points<br>
          Your value = Your points × Point price
          
          <div class="farm-text">
            Don't have an xStocks account?<br>
            <a href="https://defi.xstocks.fi/points?ref=DRAGON" target="_blank">Register now for +20% permanent boost</a>
          </div>
        </div>
      </div>

      <!-- RIGHT -->
      <div class="card">
        <div class="main-result">
          <div class="main-result-label">Estimated Airdrop Value</div>
          <div class="main-result-value" id="yourValue">$0</div>

          <div class="details">
            <div class="detail-item">
              <div class="detail-label">Point value</div>
              <div class="detail-value highlight" id="pointPrice">$0.00</div>
            </div>
            <div class="detail-item">
              <div class="detail-label">Selected FDV</div>
              <div class="detail-value" id="selectedFDV">$250M</div>
            </div>
            <div class="detail-item">
              <div class="detail-label">Airdrop %</div>
              <div class="detail-value" id="selectedAirdrop">10%</div>
            </div>
          </div>
        </div>

        <div class="scenarios">
          <div class="scenario">
            <div>
              <div class="scenario-name">FUD</div>
              <div class="scenario-info">5% Airdrop · $100M FDV</div>
            </div>
            <div class="scenario-value" id="fudValue">$0</div>
          </div>

          <div class="scenario">
            <div>
              <div class="scenario-name">Normal</div>
              <div class="scenario-info">10% Airdrop · $500M FDV</div>
            </div>
            <div class="scenario-value" id="normalValue">$0</div>
          </div>

          <div class="scenario">
            <div>
              <div class="scenario-name">FOMO</div>
              <div class="scenario-info">20% Airdrop · $1B FDV</div>
            </div>
            <div class="scenario-value" id="fomoValue">$0</div>
          </div>
        </div>
      </div>
    </div>

    <div class="footer">
      This is an estimate based on unofficial calculations. It does not constitute financial advice or a prediction of real value.<br>
      Created by DragonCrip → X: <a href="https://x.com/DragonCrip" target="_blank">@DragonCrip</a>
    </div>
  </div>

  <script>
    let airdropPct = 10;
    let fdv = 250;
    let totalPointsRaw = 14275314418;

    function formatNumber(num) {
      return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }

    function formatMoney(num) {
      // Siempre número completo con separador de miles
      return '$' + Math.round(num).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }

    function formatAndCalculate(input) {
      let value = input.value.replace(/\D/g, '');
      if (value === '') {
        input.value = '';
        calculate();
        return;
      }
      input.value = formatNumber(value);
      calculate();
    }

    function setAirdrop(pct, btn) {
      airdropPct = pct;
      document.querySelectorAll('#airdropGroup .btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('selectedAirdrop').textContent = pct + '%';
      calculate();
    }

    function setFDV(value, btn) {
      fdv = value;
      document.querySelectorAll('#fdvGroup .btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      let label = value >= 1000 ? '$1B' : `$${value}M`;
      document.getElementById('selectedFDV').textContent = label;
      calculate();
    }

    function calculate() {
      const rawPoints = document.getElementById('yourPoints').value.replace(/,/g, '');
      const yourPoints = parseFloat(rawPoints) || 0;

      const fdvDollars = fdv * 1_000_000;
      const airdropValue = fdvDollars * (airdropPct / 100);
      const pointPrice = totalPointsRaw > 0 ? airdropValue / totalPointsRaw : 0;
      const yourAirdropValue = yourPoints * pointPrice;

      document.getElementById('yourValue').textContent = formatMoney(yourAirdropValue);
      
      if (pointPrice >= 0.01) {
        document.getElementById('pointPrice').textContent = '$' + pointPrice.toFixed(4);
      } else if (pointPrice >= 0.0001) {
        document.getElementById('pointPrice').textContent = '$' + pointPrice.toFixed(6);
      } else {
        document.getElementById('pointPrice').textContent = '$' + pointPrice.toFixed(8);
      }

      document.getElementById('fudValue').textContent = formatMoney(yourPoints * ((100 * 1_000_000 * 0.05) / totalPointsRaw));
      document.getElementById('normalValue').textContent = formatMoney(yourPoints * ((500 * 1_000_000 * 0.10) / totalPointsRaw));
      document.getElementById('fomoValue').textContent = formatMoney(yourPoints * ((1000 * 1_000_000 * 0.20) / totalPointsRaw));
    }

    async function actualizarPuntos() {
      try {
        const response = await fetch('/api/total-points');
        const data = await response.json();

        if (data.total && data.total > 10_000_000_000) {
          totalPointsRaw = data.total;

          // Número completo con separador de miles
          document.getElementById('totalPointsLabel').textContent = totalPointsRaw.toLocaleString('en-US');

          console.log('✅ Total points actualizado a:', totalPointsRaw.toLocaleString());
          calculate();
        }
      } catch (e) {
        console.error('❌ Error actualizando puntos:', e);
      }
    }

    actualizarPuntos();
    setInterval(actualizarPuntos, 60 * 60 * 1000);
    calculate();
  </script>
</body>
</html>
